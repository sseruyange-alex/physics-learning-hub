<script>
// ==================== NAV ====================
function showPage(page) {
    document.querySelectorAll('section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('#mainNav button').forEach(b => b.classList.remove('nav-active'));
    const el = document.getElementById(page);
    if (el) el.classList.add('active');
    const nb = document.getElementById('nav-' + page);
    if (nb) nb.classList.add('nav-active');
    if (page === 'quiz') mainQuizInit();
    if (page === 'experiments') setTimeout(() => { initOhmsChart(); updateCircuit(); pendInitCanvas(); }, 80);
    window.scrollTo(0, 0);
}
function openModulePage(type) {
    document.querySelectorAll('section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('#mainNav button').forEach(b => b.classList.remove('nav-active'));
    document.getElementById('module-page').classList.add('active');
    showModule(type);
    window.scrollTo(0, 0);
}

// ==================== ANIMATED CIRCUIT ====================
let circuitParticles = [];
let circuitAnimFrame = null;
let circuitV = 6, circuitR = 100;

function updateCircuit() {
    circuitV = parseFloat(document.getElementById('voltage').value);
    circuitR = parseFloat(document.getElementById('resistance').value);
    const I = circuitV / circuitR;

    const V_MAX = 100;   // 🔥 changed from 20 to 100
    const R_MAX = 500;

    document.getElementById('vValue').textContent = circuitV.toFixed(1) + ' V';
    document.getElementById('rValue').textContent = circuitR + ' Ω';
    document.getElementById('roV').textContent = circuitV.toFixed(1) + ' V';
    document.getElementById('roR').textContent = circuitR + ' Ω';
    document.getElementById('roI').textContent = I.toFixed(4) + ' A';

    // Voltage bar (UPDATED)
    document.getElementById('vBar').style.width = (circuitV / V_MAX * 100) + '%';
    document.getElementById('vBar-label').textContent = circuitV.toFixed(1) + ' / ' + V_MAX + ' V';

    // Resistance bar (unchanged)
    document.getElementById('rBar').style.width = (circuitR / R_MAX * 100) + '%';
    document.getElementById('rBar-label').textContent = circuitR + ' / ' + R_MAX + ' Ω';

    // Current bar (UPDATED properly scaled)
    const iMax = V_MAX / 10; // keeps your original physics idea
    document.getElementById('iBar').style.width = Math.min(I / iMax * 100, 100) + '%';
    document.getElementById('iBar-label').textContent = I.toFixed(4) + ' A';
}

// Circuit path: waypoints [x,y], total path length computed
function initCircuit() {
    circuitParticles = [];
    const count = 12;
    for (let i = 0; i < count; i++) {
        circuitParticles.push({ t: i / count });
    }
    if (!circuitAnimFrame) animateCircuit();
}

// Path definition (clockwise rectangle with component positions)
// Canvas 520x300, scale: battery left, bulb top, resistor right
const PATH = [
    [80, 240], [80, 60], [220, 60], [300, 60], [440, 60],
    [440, 240], [300, 240], [220, 240], [80, 240]
];

function pathLength(pts) {
    let len = 0;
    for (let i = 0; i < pts.length - 1; i++) {
        const dx = pts[i+1][0] - pts[i][0], dy = pts[i+1][1] - pts[i][1];
        len += Math.sqrt(dx*dx + dy*dy);
    }
    return len;
}

function pathPoint(pts, t) {
    const total = pathLength(pts);
    let target = ((t % 1) + 1) % 1 * total;
    for (let i = 0; i < pts.length - 1; i++) {
        const dx = pts[i+1][0] - pts[i][0], dy = pts[i+1][1] - pts[i][1];
        const seg = Math.sqrt(dx*dx + dy*dy);
        if (target <= seg) {
            const frac = target / seg;
            return [pts[i][0] + dx*frac, pts[i][1] + dy*frac];
        }
        target -= seg;
    }
    return pts[pts.length - 1];
}

let lastCircuitTS = null;
function animateCircuit() {
    const canvas = document.getElementById('circuitCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;

    const I = circuitV / circuitR;
    const safeI = isNaN(I) ? 0 : I;
    const speed = Math.min(safeI / 2.0, 0.8) * 0.003; // normalized to path

    ctx.clearRect(0, 0, W, H);

    // Background
    ctx.fillStyle = '#0a1628';
    ctx.fillRect(0, 0, W, H);

    // Draw wires
    ctx.beginPath();
    ctx.moveTo(PATH[0][0], PATH[0][1]);
    PATH.forEach(p => ctx.lineTo(p[0], p[1]));
    ctx.strokeStyle = '#37474f';
    ctx.lineWidth = 4;
    ctx.stroke();

    // === BATTERY (left side, vertical) ===
    const bx = 80, by1 = 200, by2 = 130;
    // body
    ctx.fillStyle = '#1a237e';
    ctx.fillRect(bx - 18, by2, 36, by1 - by2);
    ctx.strokeStyle = '#3949ab';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(bx - 18, by2, 36, by1 - by2);
    // + and - terminals
    ctx.fillStyle = '#ef5350';
    ctx.fillRect(bx - 10, by2 - 8, 20, 8);
    ctx.fillStyle = '#78909c';
    ctx.fillRect(bx - 10, by1, 20, 8);
    // label
    ctx.fillStyle = '#fdd835';
    ctx.font = 'bold 11px Arial';
    ctx.textAlign = 'center';
    ctx.fillText('DRY CELL', bx, (by1 + by2) / 2 + 4);
    ctx.fillStyle = '#ef5350';
    ctx.font = 'bold 14px Arial';
    ctx.fillText('+', bx, by2 - 12);
    ctx.fillStyle = '#90a4ae';
    ctx.fillText('−', bx, by1 + 18);
    // voltage label
    ctx.fillStyle = '#fdd835';
    ctx.font = '10px Arial';
    ctx.fillText(circuitV.toFixed(1) + 'V', bx + 26, (by1 + by2) / 2 + 4);

    // === RESISTOR (right side, vertical) ===
    const rx = 440, ry1 = 180, ry2 = 120;
    const rH = ry1 - ry2;
    ctx.fillStyle = '#4a148c';
    ctx.fillRect(rx - 14, ry2, 28, rH);
    ctx.strokeStyle = '#9c27b0';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(rx - 14, ry2, 28, rH);
    // zigzag pattern inside
    ctx.beginPath();
    ctx.strokeStyle = '#ce93d8';
    ctx.lineWidth = 1.5;
    const zSteps = 6;
    const zStep = rH / zSteps;
    ctx.moveTo(rx, ry2 + 4);
    for (let i = 0; i < zSteps; i++) {
        ctx.lineTo(rx + (i % 2 === 0 ? 8 : -8), ry2 + 4 + zStep * (i + 0.5));
    }
    ctx.lineTo(rx, ry1 - 4);
    ctx.stroke();
    ctx.fillStyle = '#ce93d8';
    ctx.font = 'bold 10px Arial';
    ctx.textAlign = 'center';
    ctx.fillText(circuitR + 'Ω', rx, ry1 + 14);
    ctx.fillText('R', rx, (ry1 + ry2) / 2 + 4);

    // === BULB (top center) ===
    const bulbX = 300, bulbY = 60;
    const bulbR = 22;
    const brightness = Math.min(I / 0.5, 1);
    const bulbGlow = `rgba(255, ${Math.floor(200 + 55*brightness)}, 0, ${0.15 + 0.6*brightness})`;
    // glow
    if (brightness > 0.05) {
        const grd = ctx.createRadialGradient(bulbX, bulbY, 0, bulbX, bulbY, bulbR * 2.5);
        grd.addColorStop(0, bulbGlow);
        grd.addColorStop(1, 'rgba(255,200,0,0)');
        ctx.beginPath();
        ctx.arc(bulbX, bulbY, bulbR * 2.5, 0, Math.PI * 2);
        ctx.fillStyle = grd;
        ctx.fill();
    }
    // glass
    ctx.beginPath();
    ctx.arc(bulbX, bulbY, bulbR, 0, Math.PI * 2);
    const bulbFill = `rgba(255, ${Math.floor(180 + 75*brightness)}, 0, ${0.1 + 0.6*brightness})`;
    ctx.fillStyle = bulbFill;
    ctx.fill();
    ctx.strokeStyle = '#ffd600';
    ctx.lineWidth = 2;
    ctx.stroke();
    // filament
    ctx.beginPath();
    ctx.moveTo(bulbX - 8, bulbY + 4);
    ctx.lineTo(bulbX - 4, bulbY - 4);
    ctx.lineTo(bulbX, bulbY + 4);
    ctx.lineTo(bulbX + 4, bulbY - 4);
    ctx.lineTo(bulbX + 8, bulbY + 4);
    ctx.strokeStyle = brightness > 0.1 ? '#fff' : '#888';
    ctx.lineWidth = 1.5;
    ctx.stroke();
    ctx.fillStyle = '#ffd600';
    ctx.font = '10px Arial';
    ctx.textAlign = 'center';
    ctx.fillText('BULB', bulbX, bulbY + bulbR + 14);

    // === SWITCH (top between battery and bulb) ===
    const sx = 160, sy = 60;
    ctx.beginPath();
    ctx.arc(sx - 14, sy, 4, 0, Math.PI * 2);
    ctx.arc(sx + 14, sy, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#78909c';
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(sx - 10, sy);
    ctx.lineTo(sx + 10, sy - 12);
    ctx.strokeStyle = '#90a4ae';
    ctx.lineWidth = 2.5;
    ctx.stroke();
    ctx.fillStyle = '#90a4ae';
    ctx.font = '10px Arial';
    ctx.textAlign = 'center';
    ctx.fillText('SWITCH', sx, sy + 16);

    // === AMMETER (bottom center) ===
    const ax = 220, ay = 240;
    ctx.beginPath();
    ctx.arc(ax, ay, 16, 0, Math.PI * 2);
    ctx.fillStyle = '#263238';
    ctx.fill();
    ctx.strokeStyle = '#43a047';
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.fillStyle = '#43a047';
    ctx.font = 'bold 12px Arial';
    ctx.textAlign = 'center';
    ctx.fillText('A', ax, ay + 4);
    ctx.font = '9px Arial';
    ctx.fillStyle = '#81c784';
    ctx.fillText(I.toFixed(3)+'A', ax, ay + 18);

    // === CURRENT DIRECTION ARROWS on wires ===
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    [[160, 60, 1, 0], [440, 150, 0, -1], [340, 240, -1, 0], [80, 150, 0, 1]].forEach(([x, y, dx, dy]) => {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(Math.atan2(dy, dx));
        ctx.beginPath();
        ctx.moveTo(-6, -5); ctx.lineTo(6, 0); ctx.lineTo(-6, 5);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
    });

    // === PARTICLES ===
    circuitParticles.forEach(p => {
        p.t = (p.t + speed) % 1;
        const pos = pathPoint(PATH, p.t);
        ctx.beginPath();
        ctx.arc(pos[0], pos[1], 5, 0, Math.PI * 2);
        ctx.fillStyle = '#ef5350';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(pos[0], pos[1], 3, 0, Math.PI * 2);
        ctx.fillStyle = '#ffcdd2';
        ctx.fill();
    });

    circuitAnimFrame = requestAnimationFrame(animateCircuit);
}

// Ohm's law chart
let ohmsChart, chartInited = false, trialCount = 1;
function initOhmsChart() {
    if (chartInited) return;
    const ctx = document.getElementById('ohmsChart');
    if (!ctx) return;
    ohmsChart = new Chart(ctx, {
        type: 'scatter',
        data: { datasets: [{ label: 'V vs I', data: [], borderColor: '#0d47a1', backgroundColor: 'rgba(13,71,161,0.15)', borderWidth: 2, pointRadius: 6, showLine: true, tension: 0.1, fill: true }] },
        options: { responsive: true, maintainAspectRatio: false, scales: { x: { title: { display: true, text: 'Voltage (V)' }, beginAtZero: true }, y: { title: { display: true, text: 'Current (A)' }, beginAtZero: true } } }
    });
    chartInited = true;
}
function recordData() {
    const V = circuitV, R = circuitR, I = V / R;
    document.getElementById('dataTable').innerHTML += `<tr><td>${trialCount}</td><td>${V.toFixed(1)}</td><td>${R}</td><td>${I.toFixed(4)}</td></tr>`;
    trialCount++;
}
function showGraph() {
    initOhmsChart();
    document.getElementById('graphContainer').style.display = 'block';
    const pts = [];
    document.querySelectorAll('#dataTable tr').forEach(row => {
        const c = row.getElementsByTagName('td');
        if (c.length >= 4) pts.push({ x: parseFloat(c[1].textContent), y: parseFloat(c[3].textContent) });
    });
    pts.sort((a, b) => a.x - b.x);
    ohmsChart.data.datasets[0].data = pts;
    ohmsChart.update();
}
function resetExperiment() {
    document.getElementById('voltage').value = 6;
    document.getElementById('resistance').value = 100;
    document.getElementById('dataTable').innerHTML = '';
    document.getElementById('graphContainer').style.display = 'none';
    trialCount = 1;
    if (ohmsChart) ohmsChart.data.datasets[0].data = [];
    updateCircuit();
}

// ==================== PENDULUM ====================
let pendRunning = false, pendAngle = Math.PI / 7, pendAngleVel = 0;
let pendAnimFrame2 = null, pendLastTime = null, pendL = 0.5;
const PEND_G = 9.81;
function pendInitCanvas() {
    pendL = parseFloat(document.getElementById('pendLSlider').value);
    pendUpdateDisplay(); drawPendulum(pendAngle);
}
function pendUpdate() {
    pendL = parseFloat(document.getElementById('pendLSlider').value);
    if (pendRunning) { pendAngle = Math.PI / 7; pendAngleVel = 0; }
    pendUpdateDisplay();
    if (!pendRunning) drawPendulum(pendAngle);
}
function pendUpdateDisplay() {
    document.getElementById('pendLVal').textContent = pendL.toFixed(2) + ' m';
    const T = 2 * Math.PI * Math.sqrt(pendL / PEND_G);
    document.getElementById('pendTOut').textContent = T.toFixed(3) + ' s';
    const mt = document.getElementById('pendMT');
    mt.value = Math.min(Math.max(T, parseFloat(mt.min)), parseFloat(mt.max)).toFixed(2);
    pendCalcG();
}
function pendCalcG() {
    const T = parseFloat(document.getElementById('pendMT').value);
    document.getElementById('pendMTVal').textContent = T.toFixed(2) + ' s';
    document.getElementById('pendGOut').textContent = ((4 * Math.PI * Math.PI * pendL) / (T * T)).toFixed(3) + ' m/s²';
}
function togglePendulum() {
    pendRunning = !pendRunning;
    document.getElementById('pendBtn').textContent = pendRunning ? '⏸ Stop' : '▶ Start';
    if (pendRunning) { pendAngle = Math.PI / 7; pendAngleVel = 0; pendLastTime = null; requestAnimationFrame(pendAnimate); }
    else { cancelAnimationFrame(pendAnimFrame2); drawPendulum(pendAngle); }
}
function pendAnimate(ts) {
    if (!pendRunning) return;
    if (pendLastTime !== null) {
        const dt = Math.min((ts - pendLastTime) / 1000, 0.04);
        pendAngleVel += -(PEND_G / pendL) * Math.sin(pendAngle) * dt;
        pendAngleVel *= 0.9995;
        pendAngle += pendAngleVel * dt;
    }
    pendLastTime = ts;
    drawPendulum(pendAngle);
    pendAnimFrame2 = requestAnimationFrame(pendAnimate);
}
function drawPendulum(angle) {
    const canvas = document.getElementById('pendCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d'), W = canvas.width, H = canvas.height;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d1b40'; ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = 'rgba(255,255,255,0.04)'; ctx.lineWidth = 1;
    for (let y = 0; y < H; y += 20) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
    const cx = W / 2, pivotY = 28;
    const armLen = 40 + ((pendL - 0.10) / 1.90) * 160;
    const bx = cx + armLen * Math.sin(angle), by = pivotY + armLen * Math.cos(angle);
    ctx.fillStyle = '#42a5f5'; ctx.fillRect(cx - 22, 8, 44, 12);
    ctx.beginPath(); ctx.arc(cx, pivotY, 5, 0, Math.PI * 2); ctx.fillStyle = '#90caf9'; ctx.fill();
    ctx.beginPath(); ctx.moveTo(cx, pivotY); ctx.lineTo(bx, by);
    ctx.strokeStyle = '#90caf9'; ctx.lineWidth = 2; ctx.stroke();
    ctx.beginPath(); ctx.arc(bx, by, 14, 0, Math.PI * 2); ctx.fillStyle = '#fb8c00'; ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.25)'; ctx.lineWidth = 2; ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.75)'; ctx.font = 'bold 11px Arial'; ctx.textAlign = 'center';
    ctx.fillText('L = ' + pendL.toFixed(2) + ' m', cx + armLen * 0.5 * Math.sin(angle) + 22, pivotY + armLen * 0.5 * Math.cos(angle));
    const T = 2 * Math.PI * Math.sqrt(pendL / PEND_G);
    ctx.font = '11px Arial'; ctx.fillStyle = 'rgba(255,255,255,0.55)';
    ctx.fillText('T = ' + T.toFixed(2) + ' s', cx, H - 8);
}

