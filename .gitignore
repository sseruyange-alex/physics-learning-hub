  },
  {
    title: "Pendulum Experiment",
    color: "linear-gradient(135deg,#006064,#00838f)",
    difficulty: "Beginner", time: "30 min", concept: "🔭 Gravity & Simple Harmonic Motion",
    badge: "🔭", badgeTitle: "Gravity Detective", badgeXP: "60 XP",
    learn: ["How pendulum period depends on length — not mass","How to calculate the value of g experimentally","What simple harmonic motion means"],
    why: "Pendulums were used in the world's most accurate clocks for centuries. Today, the same physics governs earthquake seismometers and gyroscopes in aircraft navigation.",
    formula: "T = 2π√(L/g)   →   g = 4π²L / T²",
    materials: ["🧵 String or thread (1.5 m)","⚖ Small heavy bob (nut or stone)","📏 Ruler or tape measure","⏱ Stopwatch","🪝 Clamp or door frame"],
    steps: [
      { title:"Set Up the Pendulum", desc:"Tie a small heavy bob to one end of a string. Fix the other end firmly to a stand or door frame so it swings freely.", tip:"Make sure the attachment point is rigid — any wobble will affect results." },
      { title:"Measure the Length", desc:"Measure the length L from the pivot point to the center of the bob. Record this accurately.", tip:"Measure to the center of the bob's mass, not the bottom." },
      { title:"Release the Pendulum", desc:"Pull the bob to the side by no more than 15° and release it without pushing. Let it swing freely.", tip:"Keeping the angle small is important — large angles break the T = 2π√(L/g) formula." },
      { title:"Time 20 Swings", desc:"Use a stopwatch to time exactly 20 complete oscillations (left → right → left = 1 swing). Record the total time.", tip:"Start timing when you release, not when it first passes the center." },
      { title:"Calculate g", desc:"Period T = total time ÷ 20. Then use g = 4π²L / T² to calculate your experimental value of gravity.", tip:"Compare to 9.81 m/s². Repeat with 3 different lengths for accuracy." }
    ],
    questions: [
      { q:"If you double the length of the pendulum, what happens to the period?", opts:["It doubles","It halves","It increases by a factor of √2","It stays the same"], ans:2, exp:"T = 2π√(L/g). If L doubles, T = 2π√(2L/g) = √2 × original T. Period increases by factor of √2 ≈ 1.41." },
      { q:"What does the period of a pendulum NOT depend on?", opts:["Length of string","Value of gravity","Mass of the bob","All of the above"], ans:2, exp:"The period is independent of the mass of the bob! T = 2π√(L/g) contains no mass term." },
      { q:"Why must you keep the swing angle less than 15°?", opts:["It's safer","The formula T = 2π√(L/g) only works for small angles","Larger angles make it go too fast","The string might break"], ans:1, exp:"The formula T = 2π√(L/g) is derived using the small-angle approximation (sin θ ≈ θ). Larger angles break this and make the formula inaccurate." }
    ]
  }
];

function openProject(idx) {
    const p = projects[idx];
    document.getElementById('projectCardsGrid').style.display = 'none';
    document.getElementById('projectDetail').style.display = 'block';

    let stepsHTML = p.steps.map((s, i) => `
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-badge">${i+1}</div>
                <div class="step-card-title">${s.title}</div>
            </div>
            <div class="step-card-desc">${s.desc}</div>
            ${s.tip ? `<div class="step-tip">💡 <span>${s.tip}</span></div>` : ''}
        </div>`).join('');

    let matsHTML = p.materials.map(m => `<div class="proj-material">${m}</div>`).join('');

    let qHTML = p.questions.map((q, qi) => {
        const opts = q.opts.map((o, oi) => `<button class="proj-quiz-opt" id="pqopt-${qi}-${oi}" onclick="projAnswer(${idx},${qi},${oi})">${o}</button>`).join('');
        return `<div style="margin-bottom:16px;">
            <p style="font-size:14px;font-weight:bold;color:#1a1a1a;padding:10px 14px;background:#f0f4fa;border-radius:7px;margin-bottom:8px;">${qi+1}. ${q.q}</p>
            <div id="pqopts-${qi}">${opts}</div>
            <div class="proj-quiz-fb" id="pqfb-${qi}"></div>
        </div>`;
    }).join('');

    document.getElementById('projectDetailContent').innerHTML = `
        <div class="proj-detail-hero" style="background:${p.color}">
            <h2>${p.title}</h2>
            <p>Key concept: ${p.concept}</p>
            <div class="proj-info-row">
                <span class="proj-info-chip">📊 ${p.difficulty}</span>
                <span class="proj-info-chip">⏱ ${p.time}</span>
                <span class="proj-info-chip">🏆 ${p.badgeXP}</span>
            </div>
        </div>

        <div class="proj-tabs">
            <button class="proj-tab active" onclick="projTab(this,'ptab-overview-${idx}')">📋 Overview</button>
            <button class="proj-tab" onclick="projTab(this,'ptab-steps-${idx}')">🧪 Steps</button>
            <button class="proj-tab" onclick="projTab(this,'ptab-reflect-${idx}')">🧠 Reflect</button>
            <button class="proj-tab" onclick="projTab(this,'ptab-reward-${idx}')">🏆 Reward</button>
        </div>

        <!-- OVERVIEW -->
        <div id="ptab-overview-${idx}" class="proj-panel active">
            <div class="card" style="margin:0 0 14px;">
                <p style="font-size:13px;font-weight:bold;color:#0d47a1;margin:0 0 10px;">📚 What You Will Learn</p>
                ${p.learn.map(l => `<div class="learn-row"><div class="learn-icon">✅</div><div class="learn-text">${l}</div></div>`).join('')}
            </div>
            <div class="why-box">💡 <strong>Why it matters:</strong> ${p.why}</div>
            <div class="formula-box">${p.formula}</div>
            <p style="font-size:13px;font-weight:bold;color:#333;margin:14px 0 8px;">🛠 Materials Needed</p>
            <div class="proj-materials">${matsHTML}</div>
            <button class="mech-btn" onclick="projTabById('ptab-steps-${idx}',${idx})">Start Experiment →</button>
        </div>

        <!-- STEPS -->
        <div id="ptab-steps-${idx}" class="proj-panel">
            <p style="font-size:13px;color:#555;margin-bottom:12px;">Follow each step carefully. Tap a step to read the tip.</p>
            ${stepsHTML}
            <button class="mech-btn" onclick="projTabById('ptab-reflect-${idx}',${idx})">Reflect on Results →</button>
        </div>

        <!-- REFLECT -->
        <div id="ptab-reflect-${idx}" class="proj-panel">
            <div class="card" style="margin:0 0 14px;">
                <p style="font-size:14px;font-weight:bold;color:#0d47a1;margin:0 0 12px;">🧠 Test Your Understanding</p>
                ${qHTML}
            </div>
            <button class="mech-btn" onclick="projTabById('ptab-reward-${idx}',${idx})">Claim Your Reward →</button>
        </div>

        <!-- REWARD -->
        <div id="ptab-reward-${idx}" class="proj-panel">
            <div class="badge-reward">
                <div class="badge-icon">${p.badge}</div>
                <div class="badge-title">${p.badgeTitle} Badge</div>
                <div class="badge-sub" style="margin-bottom:12px;">You earned <strong>${p.badgeXP}</strong> for completing this project!</div>
                <div class="progress-bar-wrap" style="max-width:300px;margin:0 auto 12px;">
                    <div class="progress-bar-fill" style="width:100%;"></div>
                </div>
                <div style="font-size:13px;color:#555;">✅ Project Complete</div>
            </div>
            <div style="margin-top:16px;text-align:center;">
                <button class="mech-btn" onclick="closeProject()">← Back to All Projects</button>
            </div>
        </div>
    `;
    window.scrollTo(0, 0);
}

function projTab(btn, panelId) {
    const detail = document.getElementById('projectDetailContent');
    detail.querySelectorAll('.proj-tab').forEach(b => b.classList.remove('active'));
    detail.querySelectorAll('.proj-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(panelId).classList.add('active');
}
function projTabById(panelId, idx) {
    const detail = document.getElementById('projectDetailContent');
    const tabs = detail.querySelectorAll('.proj-tab');
    detail.querySelectorAll('.proj-panel').forEach(p => p.classList.remove('active'));
    tabs.forEach(b => b.classList.remove('active'));
    const panels = ['ptab-overview-'+idx,'ptab-steps-'+idx,'ptab-reflect-'+idx,'ptab-reward-'+idx];
    const ti = panels.indexOf(panelId);
    if (tabs[ti]) tabs[ti].classList.add('active');
    const el = document.getElementById(panelId);
    if (el) el.classList.add('active');
}
function projAnswer(projIdx, qi, oi) {
    const q = projects[projIdx].questions[qi];
    const opts = document.querySelectorAll(`#pqopts-${qi} .proj-quiz-opt`);
    opts.forEach(b => b.disabled = true);
    opts[oi].classList.add(oi === q.ans ? 'correct' : 'wrong');
    if (oi !== q.ans) opts[q.ans].classList.add('correct');
    const fb = document.getElementById(`pqfb-${qi}`);
    fb.textContent = q.exp;
    fb.className = 'proj-quiz-fb show ' + (oi === q.ans ? 'ok' : 'no');
}
function closeProject() {
    document.getElementById('projectCardsGrid').style.display = 'grid';
    document.getElementById('projectDetail').style.display = 'none';
    document.getElementById('projectDetailContent').innerHTML = '';
}

// ==================== MODULE SYSTEM ====================
let elecPanels=[], wavePanels=[];
function showModule(type) {
    const box = document.getElementById("moduleBox");
    box.innerHTML = '';
    if (type === "mechanics") {
        box.innerHTML = `<h3 style="margin-top:0;">⚙ Mechanics Module</h3>
        <div class="mech-tabs">
            <button class="mech-tab active" onclick="mechTab(this,'mech-overview')">Overview</button>
            <button class="mech-tab" onclick="mechTab(this,'mech-concepts')">Concepts</button>
            <button class="mech-tab" onclick="mechTab(this,'mech-laws')">Newton's Laws</button>
            <button class="mech-tab" onclick="mechTab(this,'mech-activity')">Activity</button>
            <button class="mech-tab" onclick="mechTab(this,'mech-quiz')">Quiz</button>
        </div>
        <div id="mech-overview" class="mech-panel active">
            <div class="mech-overview-bar"><p><strong>Mechanics</strong> is the branch of Physics that deals with <strong>motion</strong> and the <strong>forces</strong> acting on objects.</p></div>
            <div class="mech-topic-grid">
                <span class="mech-topic-chip">📏 Distance & Displacement</span><span class="mech-topic-chip">⚡ Speed & Velocity</span><span class="mech-topic-chip">🚀 Acceleration</span><span class="mech-topic-chip">⚖ Newton's 3 Laws</span><span class="mech-topic-chip">💥 Momentum</span><span class="mech-topic-chip">⚙ Work & Energy</span>
            </div>
            <button class="mech-btn" onclick="mechTabById('mech-concepts')">Start with Key Concepts →</button>
        </div>
        <div id="mech-concepts" class="mech-panel">
            <div class="concept-cards-grid">
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#e3eeff;">📏</div><div><div class="concept-title">Distance & Displacement</div><div class="concept-formula">scalar vs vector</div></div></div><div class="concept-body">Distance is the total path length — scalar. Displacement is straight-line change in position including direction — vector. A 400m lap: distance=400m, displacement=0m.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#e6f4ea;">⚡</div><div><div class="concept-title">Speed & Velocity</div><div class="concept-formula">v = d/t | velocity = Δx/Δt</div></div></div><div class="concept-body">Speed is magnitude only (scalar). Velocity includes direction (vector). A car at 60 km/h north — if it turns around, speed unchanged but velocity reverses.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#fff8e1;">🚀</div><div><div class="concept-title">Acceleration</div><div class="concept-formula">a = Δv / Δt</div></div></div><div class="concept-body">Rate of change of velocity — a vector. Slowing down = acceleration opposite to motion. Free-fall: g ≈ 9.81 m/s².</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#fdecea;">💥</div><div><div class="concept-title">Momentum</div><div class="concept-formula">p = mv</div></div></div><div class="concept-body">Mass × velocity. Vector quantity. In a closed system total momentum is conserved.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#f3e5f5;">⚙</div><div><div class="concept-title">Work & Energy</div><div class="concept-formula">W = F × d × cosθ</div></div></div><div class="concept-body">Work done when force moves object in force direction. KE = ½mv². PE = mgh. Net work = change in KE.</div></div>
            </div>
            <button class="mech-btn" onclick="mechTabById('mech-laws')">Explore Newton's Laws →</button>
        </div>
        <div id="mech-laws" class="mech-panel">
            <div style="background:#f9fafb;border:1px solid #dce6f5;border-radius:8px;padding:12px 16px;margin-bottom:14px;">
                <div class="law-block"><div class="law-num">1</div><div><div class="law-title">Law of Inertia</div><div class="law-desc">A body remains at rest or uniform motion unless acted upon by a net external force.</div><span class="law-example" style="background:#e3eeff;color:#0d47a1;">Example: a book on a table stays still until pushed</span></div></div>
                <div class="law-block"><div class="law-num">2</div><div><div class="law-title">F = ma</div><div class="law-desc">Net force = mass × acceleration. Larger force → greater acceleration. Larger mass → resists more.</div><span class="law-example" style="background:#fff8e1;color:#f57f17;">Example: pushing a heavy crate needs more force</span></div></div>
                <div class="law-block"><div class="law-num">3</div><div><div class="law-title">Action & Reaction</div><div class="law-desc">Every action has an equal and opposite reaction. Forces act in pairs on different bodies.</div><span class="law-example" style="background:#e6f4ea;color:#2e7d32;">Example: rocket expels gas down, thrust pushes it up</span></div></div>
            </div>
            <div class="mech-calc-box">
                <div class="mech-calc-row"><label>Mass (kg)</label><input type="range" id="mechMass" min="1" max="100" value="20" oninput="mechCalcF()"><span class="mech-calc-val" id="mechMassVal">20 kg</span></div>
                <div class="mech-calc-row"><label>Acceleration (m/s²)</label><input type="range" id="mechAcc" min="0" max="20" value="5" step="0.5" oninput="mechCalcF()"><span class="mech-calc-val" id="mechAccVal">5.0 m/s²</span></div>
                <div class="mech-calc-result"><span class="mech-calc-result-label">Net Force</span><span class="mech-calc-result-val" id="mechForceOut">100 N</span></div>
            </div>
            <button class="mech-btn" style="margin-top:14px;" onclick="mechTabById('mech-activity')">Go to Activity →</button>
        </div>
        <div id="mech-activity" class="mech-panel">
            <div class="activity-card">
                <p style="font-size:14px;font-weight:bold;margin-bottom:6px;">🎯 Drop Test — Measuring g</p>
                <div class="activity-step"><div class="step-num">1.</div><div class="step-text">Choose 3–5 drop heights.</div></div>
                <div class="activity-step"><div class="step-num">2.</div><div class="step-text">Drop a dense object, time the fall. Repeat 3× and average.</div></div>
                <div class="activity-step"><div class="step-num">3.</div><div class="step-text">Calculate g = 2h / t².</div></div>
                <div class="activity-step"><div class="step-num">4.</div><div class="step-text">Compare to 9.81 m/s² and discuss sources of error.</div></div>
            </div>
            <div class="mech-calc-box">
                <div class="mech-calc-row"><label>Height h (m)</label><input type="range" id="mechH" min="0.2" max="3" step="0.1" value="1" oninput="mechCalcG()"><span class="mech-calc-val" id="mechHVal">1.0 m</span></div>
                <div class="mech-calc-row"><label>Fall time t (s)</label><input type="range" id="mechT" min="0.1" max="1.5" step="0.01" value="0.45" oninput="mechCalcG()"><span class="mech-calc-val" id="mechTVal">0.45 s</span></div>
                <div class="mech-calc-result"><span class="mech-calc-result-label">g = 2h / t²</span><span class="mech-calc-result-val" id="mechGOut">9.88 m/s²</span></div>
            </div>
            <button class="mech-btn" style="margin-top:12px;" onclick="mechTabById('mech-quiz')">Test Knowledge →</button>
        </div>
        <div id="mech-quiz" class="mech-panel">
            <div id="mechQBox"></div>
            <button class="mech-btn" id="mechNextBtn" style="display:none;margin-top:10px;" onclick="mechNextQ()">Next Question →</button>
        </div>`;
        mechInitQuiz(); mechCalcF(); mechCalcG();
    } else if (type === "electricity") {
        box.innerHTML = `<h3 style="margin-top:0;">🔌 Electricity Module</h3>
        <div class="mech-tabs">
            <button class="mech-tab active" onclick="modTab(this,'elec-overview')">Overview</button>
            <button class="mech-tab" onclick="modTab(this,'elec-concepts')">Concepts</button>
            <button class="mech-tab" onclick="modTab(this,'elec-laws')">Circuit Laws</button>
            <button class="mech-tab" onclick="modTab(this,'elec-activity')">Activity</button>
            <button class="mech-tab" onclick="modTab(this,'elec-quiz')">Quiz</button>
        </div>
        <div id="elec-overview" class="mech-panel active">
            <div class="mech-overview-bar"><p><strong>Electricity</strong> deals with the <strong>flow of electric charge</strong> and the behaviour of <strong>circuits</strong>.</p></div>
            <div class="mech-topic-grid"><span class="mech-topic-chip">⚡ Electric Charge</span><span class="mech-topic-chip">🔋 Voltage</span><span class="mech-topic-chip">💡 Current</span><span class="mech-topic-chip">🔩 Resistance</span><span class="mech-topic-chip">📐 Ohm's Law</span><span class="mech-topic-chip">🔗 Circuits</span></div>
            <button class="mech-btn" onclick="modTabById('elec-concepts',elecPanels)">Start with Key Concepts →</button>
        </div>
        <div id="elec-concepts" class="mech-panel">
            <div class="concept-cards-grid">
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#e3eeff;">⚡</div><div><div class="concept-title">Electric Charge</div><div class="concept-formula">unit: Coulomb (C)</div></div></div><div class="concept-body">Charge is a fundamental property — positive (protons) or negative (electrons). Like charges repel; unlike attract.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#e6f4ea;">🔋</div><div><div class="concept-title">Voltage</div><div class="concept-formula">V = W/Q | unit: Volt (V)</div></div></div><div class="concept-body">Voltage is the energy per unit charge — the push driving current. 9V battery gives 9J per coulomb.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#fff8e1;">💡</div><div><div class="concept-title">Electric Current</div><div class="concept-formula">I = Q/t | unit: Ampere (A)</div></div></div><div class="concept-body">Current is the rate of flow of charge. More current = more charge per second.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#fdecea;">🔩</div><div><div class="concept-title">Resistance</div><div class="concept-formula">R = V/I | unit: Ohm (Ω)</div></div></div><div class="concept-body">Resistance opposes current flow. Long thin wires have higher resistance.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#f3e5f5;">💡</div><div><div class="concept-title">Electrical Power</div><div class="concept-formula">P = VI = I²R</div></div></div><div class="concept-body">Power is the rate of energy transfer in Watts. A 60W bulb converts 60J every second.</div></div>
            </div>
            <button class="mech-btn" onclick="modTabById('elec-laws',elecPanels)">Explore Circuit Laws →</button>
        </div>
        <div id="elec-laws" class="mech-panel">
            <div style="background:#f9fafb;border:1px solid #dce6f5;border-radius:8px;padding:12px 16px;margin-bottom:14px;">
                <div class="law-block"><div class="law-num">1</div><div><div class="law-title">Ohm's Law — V = IR</div><div class="law-desc">Voltage across a conductor is directly proportional to current at constant temperature.</div><span class="law-example" style="background:#e3eeff;color:#0d47a1;">Doubling voltage doubles current if R is fixed</span></div></div>
                <div class="law-block"><div class="law-num">2</div><div><div class="law-title">Kirchhoff's Current Law</div><div class="law-desc">Current entering a junction = current leaving. Charge is conserved.</div><span class="law-example" style="background:#fff8e1;color:#f57f17;">3A in → 1A + 2A out</span></div></div>
                <div class="law-block"><div class="law-num">3</div><div><div class="law-title">Kirchhoff's Voltage Law</div><div class="law-desc">Sum of voltages around any closed loop = zero.</div><span class="law-example" style="background:#e6f4ea;color:#2e7d32;">12V battery → voltages across resistors sum to 12V</span></div></div>
            </div>
            <div class="mech-calc-box">
                <div class="mech-calc-row"><label>Voltage V (V)</label><input type="range" id="elecV" min="1" max="24" value="9" step="0.5" oninput="elecCalc()"><span class="mech-calc-val" id="elecVVal">9.0 V</span></div>
                <div class="mech-calc-row"><label>Resistance R (Ω)</label><input type="range" id="elecR" min="1" max="200" value="50" oninput="elecCalc()"><span class="mech-calc-val" id="elecRVal">50 Ω</span></div>
                <div class="mech-calc-result"><span class="mech-calc-result-label">Current I = V / R</span><span class="mech-calc-result-val" id="elecIOut">0.180 A</span></div>
            </div>
            <button class="mech-btn" style="margin-top:14px;" onclick="modTabById('elec-activity',elecPanels)">Go to Activity →</button>
        </div>
        <div id="elec-activity" class="mech-panel">
            <div class="activity-card">
                <p style="font-size:14px;font-weight:bold;margin-bottom:6px;">🎯 Verify Ohm's Law</p>
                <div class="activity-step"><div class="step-num">1.</div><div class="step-text">Connect resistor in series with ammeter; voltmeter in parallel.</div></div>
                <div class="activity-step"><div class="step-num">2.</div><div class="step-text">Set voltage at 2V, 4V, 6V, 8V, 10V and record current.</div></div>
                <div class="activity-step"><div class="step-num">3.</div><div class="step-text">Plot V vs I. A straight line through origin confirms Ohm's Law.</div></div>
            </div>
            <button class="mech-btn" onclick="modTabById('elec-quiz',elecPanels)">Test Knowledge →</button>
        </div>
        <div id="elec-quiz" class="mech-panel">
            <div id="elecQBox"></div>
            <button class="mech-btn" id="elecNextBtn" style="display:none;margin-top:10px;" onclick="elecNextQ()">Next Question →</button>
        </div>`;
        elecPanels=['elec-overview','elec-concepts','elec-laws','elec-activity','elec-quiz'];
        elecInitQuiz(); elecCalc();
    } else if (type === "waves") {
        box.innerHTML = `<h3 style="margin-top:0;">🌊 Waves Module</h3>
        <div class="mech-tabs">
            <button class="mech-tab active" onclick="modTab(this,'wave-overview')">Overview</button>
            <button class="mech-tab" onclick="modTab(this,'wave-concepts')">Concepts</button>
            <button class="mech-tab" onclick="modTab(this,'wave-laws')">Wave Behaviour</button>
            <button class="mech-tab" onclick="modTab(this,'wave-activity')">Activity</button>
            <button class="mech-tab" onclick="modTab(this,'wave-quiz')">Quiz</button>
        </div>
        <div id="wave-overview" class="mech-panel active">
            <div class="mech-overview-bar"><p><strong>Waves</strong> transfer energy without transferring matter. Found in sound, light, and all communications.</p></div>
            <div class="mech-topic-grid"><span class="mech-topic-chip">🔊 Sound Waves</span><span class="mech-topic-chip">☀ Light Waves</span><span class="mech-topic-chip">📡 EM Spectrum</span><span class="mech-topic-chip">🔁 Reflection</span><span class="mech-topic-chip">📐 Refraction</span><span class="mech-topic-chip">🌐 Wave Equation</span></div>
            <button class="mech-btn" onclick="modTabById('wave-concepts',wavePanels)">Start with Key Concepts →</button>
        </div>
        <div id="wave-concepts" class="mech-panel">
            <div class="concept-cards-grid">
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#e3eeff;">〰</div><div><div class="concept-title">Types of Waves</div><div class="concept-formula">Mechanical vs EM</div></div></div><div class="concept-body">Mechanical waves need a medium. EM waves travel at 3×10⁸ m/s in vacuum. Transverse: vibration ⊥ direction. Longitudinal: vibration ∥ direction.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#e6f4ea;">🔊</div><div><div class="concept-title">Sound Waves</div><div class="concept-formula">~340 m/s in air</div></div></div><div class="concept-body">Longitudinal wave — compressions and rarefactions. Speed ≈ 340 m/s in air. Pitch → frequency; loudness → amplitude.</div></div>
                <div class="concept-card" onclick="this.classList.toggle('open')"><div class="concept-header"><div class="concept-icon" style="background:#f3e5f5;">🌐</div><div><div class="concept-title">The Wave Equation</div><div class="concept-formula">v = f × λ</div></div></div><div class="concept-body">Speed = frequency × wavelength. If frequency doubles in the same medium, wavelength halves.</div></div>
            </div>
            <button class="mech-btn" onclick="modTabById('wave-laws',wavePanels)">Explore Wave Behaviour →</button>
        </div>
        <div id="wave-laws" class="mech-panel">
            <div style="background:#f9fafb;border:1px solid #dce6f5;border-radius:8px;padding:12px 16px;margin-bottom:14px;">
                <div class="law-block"><div class="law-num">1</div><div><div class="law-title">Reflection</div><div class="law-desc">Wave bounces back from a surface. Angle of incidence = angle of reflection.</div><span class="law-example" style="background:#e3eeff;color:#0d47a1;">Echo = sound reflecting off a hard wall</span></div></div>
                <div class="law-block"><div class="law-num">2</div><div><div class="law-title">Refraction</div><div class="law-desc">Wave bends when speed changes between media. Frequency stays constant.</div><span class="law-example" style="background:#fff8e1;color:#f57f17;">Straw appears bent in water</span></div></div>
                <div class="law-block"><div class="law-num">3</div><div><div class="law-title">Diffraction</div><div class="law-desc">Waves spread around corners or through gaps. Most noticeable when gap ≈ wavelength.</div><span class="law-example" style="background:#e6f4ea;color:#2e7d32;">Sound travels around corners better than light</span></div></div>
            </div>
            <div class="mech-calc-box">
                <div class="mech-calc-row"><label>Frequency f (Hz)</label><input type="range" id="waveF" min="1" max="1000" value="340" oninput="waveCalc()"><span class="mech-calc-val" id="waveFVal">340 Hz</span></div>
                <div class="mech-calc-row"><label>Wavelength λ (m)</label><input type="range" id="waveLam" min="0.1" max="10" value="1" step="0.1" oninput="waveCalc()"><span class="mech-calc-val" id="waveLamVal">1.0 m</span></div>
                <div class="mech-calc-result"><span class="mech-calc-result-label">Speed v = f × λ</span><span class="mech-calc-result-val" id="waveVOut">340 m/s</span></div>
            </div>
            <button class="mech-btn" style="margin-top:14px;" onclick="modTabById('wave-activity',wavePanels)">Go to Activity →</button>
        </div>
        <div id="wave-activity" class="mech-panel">
            <div class="activity-card">
                <p style="font-size:14px;font-weight:bold;margin-bottom:6px;">🎯 Speed of Sound Using Echo</p>
                <p style="font-size:13px;color:#444;margin-bottom:8px;"><strong>v = 2d / t</strong></p>
                <div class="activity-step"><div class="step-num">1.</div><div class="step-text">Stand 50+ m from a flat wall. Clap boards and listen for the echo.</div></div>
                <div class="activity-step"><div class="step-num">2.</div><div class="step-text">Time 20 claps; divide by 20 to get time t for one echo.</div></div>
                <div class="activity-step"><div class="step-num">3.</div><div class="step-text">Calculate v = 2d / t. Compare to 340 m/s.</div></div>
            </div>
            <button class="mech-btn" onclick="modTabById('wave-quiz',wavePanels)">Test Knowledge →</button>
        </div>
        <div id="wave-quiz" class="mech-panel">
            <div id="waveQBox"></div>
            <button class="mech-btn" id="waveNextBtn" style="display:none;margin-top:10px;" onclick="waveNextQ()">Next Question →</button>
        </div>`;
        wavePanels=['wave-overview','wave-concepts','wave-laws','wave-activity','wave-quiz'];
        waveInitQuiz(); waveCalc();
    }
}

function modTab(btn, panelId) {
    const box=document.getElementById('moduleBox');
    box.querySelectorAll('.mech-tab').forEach(b=>b.classList.remove('active'));
    box.querySelectorAll('.mech-panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active'); document.getElementById(panelId).classList.add('active');
}
function modTabById(panelId, panels) {
    const box=document.getElementById('moduleBox'), tabs=box.querySelectorAll('.mech-tab');
    box.querySelectorAll('.mech-panel').forEach(p=>p.classList.remove('active'));
    tabs.forEach(b=>b.classList.remove('active'));
    const idx=panels.indexOf(panelId);
    if(tabs[idx])tabs[idx].classList.add('active');
    const el=document.getElementById(panelId); if(el)el.classList.add('active');
}
function mechTab(btn, panelId) {
    const box=document.getElementById('moduleBox');
    box.querySelectorAll('.mech-tab').forEach(b=>b.classList.remove('active'));
    box.querySelectorAll('.mech-panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active'); document.getElementById(panelId).classList.add('active');
}
function mechTabById(panelId) {
    const panels=['mech-overview','mech-concepts','mech-laws','mech-activity','mech-quiz'];
    const box=document.getElementById('moduleBox');
    box.querySelectorAll('.mech-tab').forEach(b=>b.classList.remove('active'));
    box.querySelectorAll('.mech-panel').forEach(p=>p.classList.remove('active'));
    const idx=panels.indexOf(panelId);
    box.querySelectorAll('.mech-tab')[idx].classList.add('active');
    document.getElementById(panelId).classList.add('active');
}
function mechCalcF(){const m=parseFloat(document.getElementById('mechMass').value),a=parseFloat(document.getElementById('mechAcc').value);document.getElementById('mechMassVal').textContent=m+' kg';document.getElementById('mechAccVal').textContent=a.toFixed(1)+' m/s²';document.getElementById('mechForceOut').textContent=(m*a).toFixed(1)+' N';}
function mechCalcG(){const h=parseFloat(document.getElementById('mechH').value),t=parseFloat(document.getElementById('mechT').value);document.getElementById('mechHVal').textContent=h.toFixed(1)+' m';document.getElementById('mechTVal').textContent=t.toFixed(2)+' s';document.getElementById('mechGOut').textContent=((2*h)/(t*t)).toFixed(2)+' m/s²';}
function elecCalc(){const V=parseFloat(document.getElementById('elecV').value),R=parseFloat(document.getElementById('elecR').value);document.getElementById('elecVVal').textContent=V.toFixed(1)+' V';document.getElementById('elecRVal').textContent=R+' Ω';document.getElementById('elecIOut').textContent=(V/R).toFixed(3)+' A';}
function waveCalc(){const f=parseFloat(document.getElementById('waveF').value),l=parseFloat(document.getElementById('waveLam').value);document.getElementById('waveFVal').textContent=f+' Hz';document.getElementById('waveLamVal').textContent=l.toFixed(1)+' m';document.getElementById('waveVOut').textContent=(f*l).toFixed(1)+' m/s';}

// MODULE QUIZZES
const mechQuestions=[{q:"A car travels 100m east then 60m west. Displacement?",opts:["160 m","40 m east","40 m west","100 m"],ans:1,exp:"Displacement = 100 − 60 = 40 m east."},{q:"Which is a vector?",opts:["Speed","Distance","Mass","Velocity"],ans:3,exp:"Velocity has magnitude and direction."},{q:"5 kg object at 3 m/s². Net force?",opts:["1.67 N","8 N","15 N","0.6 N"],ans:2,exp:"F = ma = 5 × 3 = 15 N."},{q:"Newton's 1st law is the law of…",opts:["Acceleration","Gravity","Inertia","Reaction"],ans:2,exp:"Law of inertia."},{q:"Object falls 2s, g=10. Distance?",opts:["10 m","20 m","40 m","5 m"],ans:1,exp:"h = ½gt² = 20 m."}];
let mechQI=0,mechAnswered=false;
function mechInitQuiz(){mechQI=0;mechAnswered=false;mechRenderQ();}
function mechRenderQ(){mechAnswered=false;const q=mechQuestions[mechQI];document.getElementById('mechNextBtn').style.display='none';let html=`<div class="mech-quiz-q">${mechQI+1}/${mechQuestions.length} — ${q.q}</div><div class="mech-quiz-opts">`;q.opts.forEach((o,i)=>{html+=`<button class="mech-quiz-opt" onclick="mechAnswer(${i})">${o}</button>`;});html+=`</div><div class="mech-quiz-feedback" id="mechQFB"></div>`;document.getElementById('mechQBox').innerHTML=html;}
function mechAnswer(i){if(mechAnswered)return;mechAnswered=true;const q=mechQuestions[mechQI];const btns=document.querySelectorAll('#mechQBox .mech-quiz-opt');btns[i].classList.add(i===q.ans?'correct':'wrong');if(i!==q.ans)btns[q.ans].classList.add('correct');const fb=document.getElementById('mechQFB');fb.textContent=q.exp;fb.className='mech-quiz-feedback show '+(i===q.ans?'ok':'no');const nb=document.getElementById('mechNextBtn');if(mechQI<mechQuestions.length-1){nb.textContent='Next →';nb.style.display='inline-block';}else{nb.textContent='🎉 Restart';nb.style.display='inline-block';nb.onclick=()=>{mechQI=0;mechRenderQ();nb.onclick=mechNextQ;};}}
function mechNextQ(){mechQI++;mechRenderQ();}

const elecQuestions=[{q:"Unit of electric current?",opts:["Volt","Ohm","Ampere","Watt"],ans:2,exp:"Current in Amperes (A)."},{q:"R doubles, V same. Current?",opts:["Doubles","Halves","Same","Quadruples"],ans:1,exp:"I = V/R. R doubles → I halves."},{q:"In parallel, same across all branches?",opts:["Current","Resistance","Voltage","Power"],ans:2,exp:"Voltage is the same across all parallel branches."},{q:"Which gives power?",opts:["P=IR","P=V/I","P=VI","P=V+I"],ans:2,exp:"P = VI."},{q:"5A from 230V. Power?",opts:["46W","235W","1150W","460W"],ans:2,exp:"P = 230 × 5 = 1150 W."}];
let elecQI=0,elecAnswered=false;
function elecInitQuiz(){elecQI=0;elecAnswered=false;elecRenderQ();}
function elecRenderQ(){elecAnswered=false;const q=elecQuestions[elecQI];document.getElementById('elecNextBtn').style.display='none';let html=`<div class="mech-quiz-q">${elecQI+1}/${elecQuestions.length} — ${q.q}</div><div class="mech-quiz-opts" id="elecOptBox">`;q.opts.forEach((o,i)=>{html+=`<button class="mech-quiz-opt" onclick="elecAnswer(${i})">${o}</button>`;});html+=`</div><div class="mech-quiz-feedback" id="elecQFB"></div>`;document.getElementById('elecQBox').innerHTML=html;}
function elecAnswer(i){if(elecAnswered)return;elecAnswered=true;const q=elecQuestions[elecQI];const btns=document.querySelectorAll('#elecOptBox .mech-quiz-opt');btns[i].classList.add(i===q.ans?'correct':'wrong');if(i!==q.ans)btns[q.ans].classList.add('correct');const fb=document.getElementById('elecQFB');fb.textContent=q.exp;fb.className='mech-quiz-feedback show '+(i===q.ans?'ok':'no');const nb=document.getElementById('elecNextBtn');if(elecQI<elecQuestions.length-1){nb.textContent='Next →';nb.style.display='inline-block';}else{nb.textContent='🎉 Restart';nb.style.display='inline-block';nb.onclick=()=>{elecQI=0;elecRenderQ();nb.onclick=elecNextQ;};}}
function elecNextQ(){elecQI++;elecRenderQ();}

const waveQuestions=[{q:"Which travels through vacuum?",opts:["Sound","Water waves","Electromagnetic","Seismic"],ans:2,exp:"EM waves travel at 3×10⁸ m/s in vacuum."},{q:"f=200Hz, λ=1.7m. Speed?",opts:["201.7","340","117.6","200"],ans:1,exp:"v = fλ = 200 × 1.7 = 340 m/s."},{q:"What determines loudness?",opts:["Frequency","Wavelength","Speed","Amplitude"],ans:3,exp:"Greater amplitude = louder."},{q:"Sound around corners = ?",opts:["Reflection","Refraction","Interference","Diffraction"],ans:3,exp:"Diffraction spreads waves around corners."},{q:"Refraction: what stays constant?",opts:["Speed","Wavelength","Frequency","Amplitude"],ans:2,exp:"Frequency stays constant during refraction."}];
let waveQI=0,waveAnswered=false;
function waveInitQuiz(){waveQI=0;waveAnswered=false;waveRenderQ();}
function waveRenderQ(){waveAnswered=false;const q=waveQuestions[waveQI];document.getElementById('waveNextBtn').style.display='none';let html=`<div class="mech-quiz-q">${waveQI+1}/${waveQuestions.length} — ${q.q}</div><div class="mech-quiz-opts" id="waveOptBox">`;q.opts.forEach((o,i)=>{html+=`<button class="mech-quiz-opt" onclick="waveAnswer(${i})">${o}</button>`;});html+=`</div><div class="mech-quiz-feedback" id="waveQFB"></div>`;document.getElementById('waveQBox').innerHTML=html;}
function waveAnswer(i){if(waveAnswered)return;waveAnswered=true;const q=waveQuestions[waveQI];const btns=document.querySelectorAll('#waveOptBox .mech-quiz-opt');btns[i].classList.add(i===q.ans?'correct':'wrong');if(i!==q.ans)btns[q.ans].classList.add('correct');const fb=document.getElementById('waveQFB');fb.textContent=q.exp;fb.className='mech-quiz-feedback show '+(i===q.ans?'ok':'no');const nb=document.getElementById('waveNextBtn');if(waveQI<waveQuestions.length-1){nb.textContent='Next →';nb.style.display='inline-block';}else{nb.textContent='🎉 Restart';nb.style.display='inline-block';nb.onclick=()=>{waveQI=0;waveRenderQ();nb.onclick=waveNextQ;};}}
function waveNextQ(){waveQI++;waveRenderQ();}

// MAIN QUIZ
const mainQuizQuestions=[
    {cat:"⚙ Mechanics",q:"Unit of force?",opts:["Joule","Newton","Watt","Pascal"],ans:1,exp:"Force in Newtons (N)."},
    {cat:"⚙ Mechanics",q:"Car travels 100m east then 60m west. Displacement?",opts:["160 m","40 m east","40 m west","100 m east"],ans:1,exp:"Displacement = 40 m east."},
    {cat:"⚙ Mechanics",q:"Which is a vector?",opts:["Speed","Distance","Mass","Velocity"],ans:3,exp:"Velocity has magnitude and direction."},
    {cat:"⚙ Mechanics",q:"5kg object, 3m/s². Net force?",opts:["1.67 N","8 N","15 N","0.6 N"],ans:2,exp:"F = ma = 15 N."},
    {cat:"⚙ Mechanics",q:"Object falls 2s (g=10). Distance?",opts:["10 m","20 m","40 m","5 m"],ans:1,exp:"h = ½gt² = 20 m."},
    {cat:"⚙ Mechanics",q:"Newton's First Law = Law of…",opts:["Acceleration","Gravity","Inertia","Reaction"],ans:2,exp:"Law of inertia."},
    {cat:"⚙ Mechanics",q:"Momentum of 4kg at 5m/s?",opts:["0.8","9","20","1.25"],ans:2,exp:"p = mv = 20 kg·m/s."},
    {cat:"🔌 Electricity",q:"Unit of current?",opts:["Volt","Ohm","Ampere","Watt"],ans:2,exp:"Current in Amperes."},
    {cat:"🔌 Electricity",q:"V doubles, R same. Current?",opts:["Halves","Same","Doubles","Quadruples"],ans:2,exp:"I = V/R. V doubles → I doubles."},
    {cat:"🔌 Electricity",q:"Parallel circuit: same across all branches?",opts:["Current","Resistance","Voltage","Power"],ans:2,exp:"Voltage is the same across all parallel branches."},
    {cat:"🔌 Electricity",q:"5A from 230V. Power?",opts:["46W","235W","1150W","460W"],ans:2,exp:"P = VI = 1150 W."},
    {cat:"🔌 Electricity",q:"Electromagnet needs?",opts:["Only magnet","Current through coil","Only battery","Plastic rod"],ans:1,exp:"Current through a coil creates the magnetic field."},
    {cat:"🔌 Electricity",q:"Which gives power?",opts:["P=IR","P=V/I","P=VI","P=V+I"],ans:2,exp:"P = VI."},
    {cat:"🔌 Electricity",q:"4Ω and 6Ω in series. Total?",opts:["2.4Ω","10Ω","24Ω","1Ω"],ans:1,exp:"Series: 4 + 6 = 10 Ω."},
    {cat:"🌊 Waves",q:"Which travels through vacuum?",opts:["Sound","Water","Electromagnetic","Seismic"],ans:2,exp:"EM waves travel at 3×10⁸ m/s in vacuum."},
    {cat:"🌊 Waves",q:"f=200Hz, λ=1.7m. Speed?",opts:["201.7","340","117.6","200"],ans:1,exp:"v = fλ = 340 m/s."},
    {cat:"🌊 Waves",q:"Loudness determined by?",opts:["Frequency","Wavelength","Speed","Amplitude"],ans:3,exp:"Greater amplitude = louder."},
    {cat:"🌊 Waves",q:"Longer pendulum: period?",opts:["Increases","Decreases","Same","Zero"],ans:0,exp:"T = 2π√(L/g). Longer L → longer T."},
    {cat:"🌊 Waves",q:"Sound around corners = ?",opts:["Reflection","Refraction","Interference","Diffraction"],ans:3,exp:"Diffraction."},
    {cat:"🌊 Waves",q:"Refraction: what stays constant?",opts:["Speed","Wavelength","Frequency","Amplitude"],ans:2,exp:"Frequency stays constant."}
];
let mainQI=0,mainScore=0,mainAnswered=false;
function mainQuizInit(){mainQI=0;mainScore=0;mainAnswered=false;document.getElementById('mainQuizFinal').style.display='none';document.getElementById('mainQBox').style.display='block';document.getElementById('mainQuizProgress').style.width='0%';document.getElementById('mainQuizCounter').textContent='0 / 20';document.getElementById('mainQuizScore').textContent='Score: 0';mainRenderQ();}
function mainRenderQ(){mainAnswered=false;const q=mainQuizQuestions[mainQI];document.getElementById('mainNextBtn').style.display='none';const cc=q.cat.includes('Mechanics')?'#0d47a1':q.cat.includes('Electricity')?'#1565c0':'#1976d2';let html=`<div style="display:inline-block;font-size:11px;font-weight:bold;color:white;background:${cc};border-radius:20px;padding:3px 12px;margin-bottom:10px;">${q.cat}</div><div class="mech-quiz-q">${mainQI+1}/20 — ${q.q}</div><div class="mech-quiz-opts" id="mainOptBox">`;q.opts.forEach((o,i)=>{html+=`<button class="mech-quiz-opt" onclick="mainAnswer(${i})">${o}</button>`;});html+=`</div><div class="mech-quiz-feedback" id="mainQFB"></div>`;document.getElementById('mainQBox').innerHTML=html;}
function mainAnswer(i){if(mainAnswered)return;mainAnswered=true;const q=mainQuizQuestions[mainQI];const btns=document.querySelectorAll('#mainOptBox .mech-quiz-opt');const correct=i===q.ans;btns[i].classList.add(correct?'correct':'wrong');if(!correct)btns[q.ans].classList.add('correct');if(correct)mainScore++;document.getElementById('mainQFB').textContent=q.exp;document.getElementById('mainQFB').className='mech-quiz-feedback show '+(correct?'ok':'no');const done=mainQI+1;document.getElementById('mainQuizProgress').style.width=(done/20*100)+'%';document.getElementById('mainQuizCounter').textContent=done+'/20';document.getElementById('mainQuizScore').textContent='Score: '+mainScore;const nb=document.getElementById('mainNextBtn');nb.textContent=mainQI<19?'Next Question →':'See Results 🏆';nb.style.display='inline-block';}
function mainNextQ(){if(mainQI<19){mainQI++;mainRenderQ();}else{mainShowFinal();}}
function mainShowFinal(){document.getElementById('mainQBox').style.display='none';document.getElementById('mainNextBtn').style.display='none';const pct=Math.round(mainScore/20*100);let grade,gc,msg;if(pct>=90){grade='Excellent! 🏆';gc='#2e7d32';msg='Outstanding! Strong grasp across all topics.';}else if(pct>=75){grade='Great Job! 🎉';gc='#1565c0';msg='Well done! Review a few more concepts.';}else if(pct>=55){grade='Good Effort! 👍';gc='#f57f17';msg='Good start! Revisit the Learning Modules.';}else{grade='Keep Practising! 📚';gc='#c62828';msg="Don't give up! Visit the modules and try again.";}document.getElementById('mainQuizFinal').style.display='block';document.getElementById('mainQuizFinal').innerHTML=`<div style="text-align:center;padding:24px 10px;background:#f9fafb;border-radius:10px;border:1px solid #dce6f5;"><div style="font-size:52px;margin-bottom:10px;">${pct>=75?'🏆':pct>=55?'👍':'📚'}</div><div style="font-size:20px;font-weight:bold;color:${gc};margin-bottom:4px;">${grade}</div><div style="font-size:34px;font-weight:bold;color:#0d47a1;">${mainScore}/20</div><div style="font-size:15px;color:#555;margin-bottom:14px;">${pct}% correct</div><div style="font-size:13px;color:#444;max-width:360px;margin:0 auto 20px;line-height:1.6;">${msg}</div><button class="mech-btn" onclick="mainQuizInit()">🔁 Try Again</button></div>`;}

// CONTACT
function submitForm(){const name=document.getElementById('contactName').value.trim(),email=document.getElementById('contactEmail').value.trim(),subject=document.getElementById('contactSubject').value.trim(),message=document.getElementById('contactMessage').value.trim(),resultEl=document.getElementById('formResult');if(!name||!email||!message){resultEl.textContent='⚠ Please fill in name, email and message.';resultEl.className='error';return;}window.location.href=`mailto:256allex256@gmail.com?subject=${encodeURIComponent(subject||'Message from '+name)}&body=${encodeURIComponent('Name: '+name+'\nEmail: '+email+'\n\n'+message)}`;resultEl.textContent='✅ Email client opened. Please send to complete.';resultEl.className='success';}

// INIT
window.onload = function() {
    mainQuizInit();
    updateCircuit();
    initCircuit();
};

function scrollToModules() {
    showPage('home'); // go to homepage

    setTimeout(() => {
        const section = document.getElementById('modulesSection');
        if (section) {
            section.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
    }, 300);
}

</script>
</body>
</html>
